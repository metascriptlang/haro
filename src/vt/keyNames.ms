		"KeyE" => GhosttyKey.GHOSTTY_KEY_E,
		"KeyF" => GhosttyKey.GHOSTTY_KEY_F,
		"KeyG" => GhosttyKey.GHOSTTY_KEY_G,
		"KeyH" => GhosttyKey.GHOSTTY_KEY_H,
		"KeyI" => GhosttyKey.GHOSTTY_KEY_I,
		"KeyJ" => GhosttyKey.GHOSTTY_KEY_J,
